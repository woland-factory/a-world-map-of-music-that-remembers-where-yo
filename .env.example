# Copy to .env and fill in. The .env file is never committed.

# Seeds a fixed demo passport on first load so a fresh visitor sees a
# partly-lit map. Set to 1 on staging, leave empty for a dark start.
SEED_DEMO=1

# Contact string for the MusicBrainz User-Agent (build-time pipeline only).
# MusicBrainz requires a way to reach you. Use your email or a project URL.
MUSICBRAINZ_CONTACT=you@example.com

# Optional error tracking (Sentry / GlitchTip). Leave empty to disable.
SENTRY_DSN=

# Optional analytics (Umami). Leave both empty to disable.
UMAMI_URL=
UMAMI_WEBSITE_ID=
